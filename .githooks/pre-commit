#!/usr/bin/env node
/**
 * Block new em dashes in user-facing copy.
 *
 * House rule: no em dashes or spaced double hyphens in anything a reader sees.
 * The site was swept clean once; this stops it drifting back, which it will,
 * because the em dash is the path of least resistance in exactly the register
 * marketing copy lives in.
 *
 * Only ADDED lines in the staged diff are checked. The repo still contains
 * legitimate dashes (the "not included" glyph in the plan comparison tables,
 * en dashes in numeric ranges), and a whole-file scan would fail on those
 * forever.
 *
 * Comments are not reader copy, so they are excluded. Deciding whether a line
 * is inside one CANNOT be done a line at a time, which is how this used to
 * work: a line in the middle of a block comment carries no opening delimiter,
 * so it read as ordinary copy. A single note in a <style> block,
 *
 *     ...on a lime accent the dark labels need a light
 *     variant here -- the base CSS assumes near-black. *\/
 *
 * failed the commit on its own second line, in fourteen files at once, none of
 * which a reader will ever see. So the file is scanned as a whole, tracking
 * whether it is inside <script> or <style> and inside a comment, and the
 * comment text is blanked before the rules run. Line numbers are preserved so
 * the report still points at the right place.
 *
 * Escape hatch: git commit --no-verify
 */

const { execSync } = require("child_process");

const RULES = [
  { re: /—/g, name: "em dash" },
  { re: /&mdash;|&#8212;|&#x2014;/gi, name: "em dash entity" },
  { re: / -- /g, name: "spaced double hyphen" },
];

/**
 * Blank every comment in `src`, keeping length and line structure so line
 * numbers still line up. Returns an array of lines, 0-indexed.
 *
 * `//` is only a comment inside <script>, and not when it follows a colon,
 * which is how a bare URL reaches the scanner. A `//` inside a string literal
 * is treated as a comment start, which is the safe direction to be wrong in
 * only for `//`: worst case a run of code is skipped, never a run of copy,
 * because a JS string holding user-facing text has no reason to contain `//`.
 */
function blankComments(src, startMode) {
  let out = "";
  let mode = startMode; // "html" | "script" | "style"
  let comment = null; // null | "html" | "block" | "line"
  let i = 0;

  const at = (s) => src.startsWith(s, i);
  const skip = (n) => {
    out += " ".repeat(n);
    i += n;
  };

  while (i < src.length) {
    const ch = src[i];

    if (ch === "\n") {
      if (comment === "line") comment = null;
      out += ch;
      i++;
      continue;
    }

    if (comment === "html") {
      if (at("-->")) {
        comment = null;
        skip(3);
      } else skip(1);
      continue;
    }
    if (comment === "block") {
      if (at("*/")) {
        comment = null;
        skip(2);
      } else skip(1);
      continue;
    }
    if (comment === "line") {
      skip(1);
      continue;
    }

    if (at("<!--")) {
      comment = "html";
      skip(4);
      continue;
    }
    if (mode !== "html" && at("/*")) {
      comment = "block";
      skip(2);
      continue;
    }
    if (mode === "script" && at("//") && src[i - 1] !== ":") {
      comment = "line";
      skip(2);
      continue;
    }

    // Tag tracking, so a `/*` in prose is not read as a CSS comment and a
    // `//` in prose is not read as a JS one.
    const rest = src.slice(i, i + 9).toLowerCase();
    if (rest.startsWith("<script")) mode = "script";
    else if (rest.startsWith("<style")) mode = "style";
    else if (rest.startsWith("</script") || rest.startsWith("</style"))
      mode = "html";

    out += ch;
    i++;
  }
  return out.split("\n");
}

let diff = "";
try {
  diff = execSync("git diff --cached -U0 --no-color -- '*.html' '*.js'", {
    encoding: "utf8",
    maxBuffer: 32 * 1024 * 1024,
  });
} catch {
  process.exit(0); // Nothing staged that we care about.
}

// Added line numbers, per file, from the diff.
const added = new Map();
let file = null;
let lineNo = 0;
for (const raw of diff.split("\n")) {
  if (raw.startsWith("+++ b/")) {
    file = raw.slice(6);
    if (!added.has(file)) added.set(file, []);
    continue;
  }
  const hunk = raw.match(/^@@ -\d+(?:,\d+)? \+(\d+)/);
  if (hunk) {
    lineNo = parseInt(hunk[1], 10);
    continue;
  }
  if (!raw.startsWith("+") || raw.startsWith("+++")) continue;
  added.get(file).push({ lineNo, text: raw.slice(1) });
  lineNo++;
}

const hits = [];
for (const [path, lines] of added) {
  if (!lines.length) continue;
  let staged;
  try {
    staged = execSync(`git show :"${path}"`, {
      encoding: "utf8",
      maxBuffer: 32 * 1024 * 1024,
    });
  } catch {
    continue; // Deleted, or unreadable from the index.
  }
  const clean = blankComments(staged, path.endsWith(".js") ? "script" : "html");

  for (const { lineNo, text } of lines) {
    // The plan tables use a dash as a "not included" glyph, not punctuation.
    if (text.includes("compare-dash")) continue;
    const codeOnly = clean[lineNo - 1] ?? text;
    for (const rule of RULES) {
      rule.re.lastIndex = 0;
      if (rule.re.test(codeOnly)) {
        hits.push({ file: path, lineNo, rule: rule.name, text: text.trim() });
        break;
      }
    }
  }
}

if (!hits.length) process.exit(0);

const red = (s) => `\x1b[31m${s}\x1b[0m`;
const dim = (s) => `\x1b[2m${s}\x1b[0m`;

console.error(
  red(`\n  ${hits.length} em dash${hits.length > 1 ? "es" : ""} in user-facing copy\n`),
);
for (const h of hits.slice(0, 20)) {
  const snippet = h.text.length > 110 ? `${h.text.slice(0, 110)}...` : h.text;
  console.error(`  ${h.file}:${h.lineNo}  ${dim(`(${h.rule})`)}`);
  console.error(`    ${snippet}\n`);
}
if (hits.length > 20) console.error(dim(`  ...and ${hits.length - 20} more\n`));

console.error(`  Rewrite by what follows the dash:
    amplification        -> colon      "the dumb part of the work: parsing redlines"
    contrast/connective  -> comma      "still open, not re-discovered"
    independent clause   -> semicolon  "it is not review; it is a guess"
    paired dashes        -> parens     "the cost (to revenue, to time) is higher"
    titles and meta      -> colon      "Midly: contract review for small firms"

  Comments are not checked. En dashes in numeric ranges (2024-2026, 11-50
  people) are correct and not checked either.
  ${dim("Genuinely need it? git commit --no-verify")}
`);
process.exit(1);
